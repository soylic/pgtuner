# Version-matrix test output (per-version JSON and stderr logs from version-matrix.sh).
# These are ephemeral outputs; only the harness scripts are committed.
scripts/matrix-output/

# Built binary
/pgtuner

# Release artefacts — built by CI, never committed. Scoped to dist/ only,
# not a bare "*.deb"/"*.rpm" — see openremedy-client's .gitignore for why
# that bit before (matched committed source templates by name coincidence).
dist/*.deb
dist/*.rpm
dist/*.tar.gz
dist/*.zip
